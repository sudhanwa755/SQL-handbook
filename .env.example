# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# DO NOT put real production credentials, API secrets or database passwords here.
# Copy this file to .env for local development with sensitive values redacted.
# ==============================================================================

# Site Configuration
SITE_URL=https://sudhanwa755.github.io/SQL-handbook
ENVIRONMENT=production

# Privacy-Preserving Analytics (Optional)
# Format for GA4: G-XXXXXXXXXX | Cloudflare: token | Plausible: domain
ANALYTICS_PROVIDER=none
GA_MEASUREMENT_ID=
CLOUDFLARE_ANALYTICS_TOKEN=
PLAUSIBLE_DOMAIN=

# Optional Serverless Form Backend (e.g. Formspree / Cloudflare Worker)
# Keep actual endpoint secrets out of client-side repository
FEEDBACK_ENDPOINT=https://formspree.io/f/example-token

# Security Headers & CSP
FORCE_HTTPS=true
CONTENT_SECURITY_POLICY_UPGRADE=true
