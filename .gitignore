# ==============================================================================
# SECRETS & ENVIRONMENT HYGIENE (.gitignore)
# Prevents leaking private API keys, secrets, tokens, credentials & build artifacts
# ==============================================================================

# Environment files and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
id_rsa
id_ed25519
credentials.json
service-account*.json
*.secret
*.token

# Node.js & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Editor & OS Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Build and Temporary Outputs
dist/
build/
out/
tmp/
temp/
*.log
scratch/
.system_generated/
